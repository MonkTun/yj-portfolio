            }
          },
          "type": "text",
          "props": {
            "content": "Dawngeon was my high-school passion project. I spearheaded development in Unity and C#, prioritizing mobile-first UX and tactile feedback. This was my first time making music, designing levels, and fielding real user feedback.",
            "variant": "body",
            "align": "left",
            "color": "foreground",
            "transform": "none"
          }
        },
