            "row": 1,
            "rowSpan": 8
          },
          "mobile": {
            "layout": {
              "rowSpan": 9
            }
          },
          "type": "text",
          "props": {
            "content": "<em><strong>21M</strong> App Store impressions.<br><strong>140,000</strong>+ downloads worldwide.<br><strong>4.6 / 5.0</strong> rating.<br>Charted <strong>#130</strong> in the App Store Adventure category.</em>",
            "variant": "caption",
            "align": "left",
            "color": "foreground",
            "transform": "none",
            "fontSize": 20
          }
        }
      ]
