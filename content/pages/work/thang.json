            }
          },
          "type": "text",
          "props": {
            "content": "Server-side rewind for latency-free input",
            "variant": "h3",
            "align": "left",
            "color": "foreground",
            "transform": "none"
          }
        },
        {
          "id": "blk_th_core_body",
          "layout": {
            "col": 1,
            "colSpan": 7,
            "row": 5,
            "rowSpan": 14
          },
          "mobile": {
            "layout": {
              "colSpan": 12,
              "row": 22,
              "rowSpan": 18
            }
          },
          "type": "text",
          "props": {
            "content": "Embarking on this journey, I immediately knew a shooter like this needs lag compensation. <br>First time learning Unreal Engine through this project, I immediately enrolled in Stephen Ulibarri's UE5 Networking course and fell in love with it. After completing the course,  I engineered 5+ core systems, including a server-side rewind algorithm for latency compensation that lets shooting, freeze states, and tag mechanics all feel instantaneous regardless of the player's connection.",
            "variant": "body",
            "align": "left",
            "color": "foreground",
            "transform": "none"
          }
        },
        {
